VITE_API_URL=http://localhost:4000
VITE_AUTH_TOKEN_TRANSPORT=BODY
VITE_DEV_BYPASS_PERMISSIONS=true
VITE_DEV_PERMISSIONS=catalog.product.view,catalog.product.manage,inventory.stock.view,inventory.stock.adjust,order.view,customer.view,cms.content.view,cms.content.manage,catalog.review.moderate,system.module.view

# Supabase Realtime: báo đơn mới/việc cần làm tức thì thay vì chờ polling 30s. Bỏ trống = chỉ dùng polling.
# Cả hai là giá trị công khai (lộ trong bundle) — dùng anon key, KHÔNG dùng service_role. Kênh công khai chỉ mang
# tín hiệu rỗng; dữ liệu thật vẫn lấy qua API có xác thực. Cài trigger DB: `yarn trigger:realtime-ping:set` (repo api).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
